# Copy to .env and fill in. NEVER commit the real .env.

# Environment: development | production
APP_ENV=development

# REQUIRED in production (app refuses to boot with the dev default):
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth / tokens
JWT_EXPIRE_MINUTES=10080          # 7 days

# CORS — comma-separated allowed origins (your frontend URLs)
CORS_ORIGINS=http://localhost:5174

# Uploads / signed file links
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=10
FILE_URL_TTL=3600                 # signed file URL lifetime (seconds)

# Seed demo data in production only if explicitly enabled
# SEED_DEMO=1

# WhatsApp service (if used)
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
